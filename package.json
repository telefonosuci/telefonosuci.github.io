{
  "name": "telefonosuci.github.io",
  "private": true,
  "description": "JS bundles for the Jekyll site: every _js/*.js is an entry, built into assets/js/",
  "scripts": {
    "build": "esbuild \"_js/*.js\" --bundle --splitting --minify --format=esm --target=es2020 --outdir=assets/js --chunk-names=chunks/[name]-[hash]",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

{"name": "Jekyll", "icon": "globe", "settings": "{\"settings\": \"{\\n    \\\"workbench.colorTheme\\\": \\\"Monokai\\\",\\n    \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"editor.tabSize\\\": 2,\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.rulers\\\": [\\n        120\\n    ],\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.formatOnSaveMode\\\": \\\"modifications\\\",\\n    \\\"files.trimTrailingWhitespace\\\": true,\\n    \\\"files.insertFinalNewline\\\": true,\\n    \\\"files.trimFinalNewlines\\\": true,\\n    \\\"git.autofetch\\\": true,\\n    \\\"files.associations\\\": {\\n        \\\"*.html\\\": \\\"liquid\\\",\\n        \\\"*.xml\\\": \\\"liquid\\\"\\n    },\\n    \\\"emmet.includeLanguages\\\": {\\n        \\\"liquid\\\": \\\"html\\\"\\n    },\\n    \\\"files.exclude\\\": {\\n        \\\"**/_site\\\": true,\\n        \\\"**/.jekyll-cache\\\": true,\\n        \\\"**/.sass-cache\\\": true\\n    },\\n    \\\"search.exclude\\\": {\\n        \\\"**/_site\\\": true,\\n        \\\"**/.jekyll-cache\\\": true,\\n        \\\"**/vendor/bundle\\\": true,\\n        \\\"**/node_modules\\\": true,\\n        \\\"**/Gemfile.lock\\\": true,\\n        \\\"**/package-lock.json\\\": true\\n    },\\n    \\\"files.watcherExclude\\\": {\\n        \\\"**/_site/**\\\": true,\\n        \\\"**/.jekyll-cache/**\\\": true,\\n        \\\"**/.sass-cache/**\\\": true,\\n        \\\"**/vendor/bundle/**\\\": true,\\n        \\\"**/node_modules/**\\\": true\\n    },\\n    \\\"terminal.integrated.env.osx\\\": {\\n        \\\"PATH\\\": \\\"/opt/homebrew/opt/ruby/bin:${env:PATH}\\\"\\n    },\\n    \\\"[liquid]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"sissel.shopify-liquid\\\",\\n        \\\"editor.formatOnSave\\\": false\\n    },\\n    \\\"[scss]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[javascript]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[json]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"[jsonc]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    },\\n    \\\"[yaml]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[ruby]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"Shopify.ruby-lsp\\\",\\n        \\\"editor.formatOnSave\\\": true\\n    },\\n    \\\"[markdown]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"DavidAnson.vscode-markdownlint\\\",\\n        \\\"editor.wordWrap\\\": \\\"on\\\",\\n        \\\"editor.quickSuggestions\\\": {\\n            \\\"other\\\": false\\n        }\\n    },\\n    \\\"markdownlint.config\\\": {\\n        \\\"MD013\\\": false,\\n        \\\"MD033\\\": false,\\n        \\\"MD041\\\": false\\n    }\\n}\"}", "extensions": "[{\"identifier\": {\"id\": \"anthropic.claude-code\"}, \"displayName\": \"Claude Code\"}, {\"identifier\": {\"id\": \"ms-ceintl.vscode-language-pack-it\"}, \"displayName\": \"Italian Language Pack\"}, {\"identifier\": {\"id\": \"pkief.material-icon-theme\"}, \"displayName\": \"Material Icon Theme\"}, {\"identifier\": {\"id\": \"eamodio.gitlens\"}, \"displayName\": \"GitLens\"}, {\"identifier\": {\"id\": \"editorconfig.editorconfig\"}, \"displayName\": \"EditorConfig\"}, {\"identifier\": {\"id\": \"sissel.shopify-liquid\"}, \"displayName\": \"Liquid\"}, {\"identifier\": {\"id\": \"mrmlnc.vscode-scss\"}, \"displayName\": \"SCSS IntelliSense\"}, {\"identifier\": {\"id\": \"redhat.vscode-yaml\"}, \"displayName\": \"YAML\"}, {\"identifier\": {\"id\": \"shopify.ruby-lsp\"}, \"displayName\": \"Ruby LSP\"}, {\"identifier\": {\"id\": \"davidanson.vscode-markdow
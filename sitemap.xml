---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
  {%- unless p.sitemap == false or p.redirect %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
  {%- endunless %}
{%- endfor %}
{%- for p in site.posts %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>

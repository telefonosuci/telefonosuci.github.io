---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%} Google ignores changefreq/priority; hreflang lives in <head> (_layouts/base.html). {%- endcomment -%}
{%- assign items = site.html_pages | concat: site.posts -%}
{%- for p in items %}
  {%- if p.sitemap == false or p.redirect %}{% continue %}{% endif %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- if p.date %}
    <lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
